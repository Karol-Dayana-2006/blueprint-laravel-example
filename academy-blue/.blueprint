updated:
    - routes/web.php
models:
    User: { name: string, email: 'string unique', password: string, role: 'enum:estudiante,instructor,admin', timestamps: timestamps }
    Category: { name: 'string:100', description: 'text nullable', timestamps: timestamps }
    Course: { title: 'string:200', description: 'text nullable', price: integer, instructor_id: 'id foreign:users.id onDelete:cascade onUpdate:cascade', category_id: 'id foreign:categories.id onDelete:cascade onUpdate:cascade' }
    Lesson: { title: 'string:200', content: text, order_number: integer, course_id: 'id foreign:courses.id onDelete:cascade onUpdate:cascade', timestamps: timestamps }
    Enrollment: { student_id: 'id foreign:users.id onDelete:cascade onUpdate:cascade', course_id: 'id foreign:courses.id onDelete:cascade onUpdate:cascade', enrollment_date: timestamp, status: 'enum:activo,completado,cancelado', indexes: [{ unique: 'student_id, course_id' }] }
